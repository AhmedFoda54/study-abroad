# ---------------------------------------------------------------------------
# Flow — environment template. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------
#
# There is deliberately NO OpenAI key here.
#
# Every model call is billed to the person who made it, using a key they enter
# themselves under Settings. A key in this file would mean the operator paying
# for other people's runs, and holding a credential they have no reason to hold.
#
# Without a key the app runs in demo mode: fully usable, nothing researched.
# ---------------------------------------------------------------------------

# Default models each stage falls back to. Any model the user's key can reach.
FLOW_RESEARCH_MODEL=gpt-5-mini
FLOW_ANALYSIS_MODEL=gpt-5-mini
FLOW_OUTREACH_MODEL=gpt-5.1

# --- Self-hosted only (the eight-service setup started by `npm run dev`) -----

GATEWAY_PORT=4000
PROFILES_PORT=4001
TARGETS_PORT=4002
PROMPTS_PORT=4003
RESEARCH_PORT=4004
ANALYSIS_PORT=4005
OUTREACH_PORT=4006
ORCHESTRATOR_PORT=4007

# Where the web app reaches the gateway.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the JSON document store lives. Leave it unset: the default is
# <repo>/data, which every service shares no matter which folder it is launched
# from. Set an absolute path only for split deployments.
# FLOW_DATA_DIR=./data

# --- Dev only: run models through your local OpenCode client -----------------
# Free models are exclusive to the OpenCode client, so local development can
# borrow it: OpenCode must be installed and its background service running
# (it starts automatically when you use OpenCode). No OpenAI key is needed in
# this mode; structured output relies on tolerant parsing and web search is
# unavailable. Never enable this on a deployed machine.
# FLOW_LLM_ENGINE=opencode
# FLOW_OPENCODE_MODEL=deepseek-v4.1-flash-free
# FLOW_OPENCODE_BIN= (only if the OpenCode executable is not auto-detected)
# Model ids rotate: list the current ones with "opencode api get /api/model".

# --- Search (research step) ---------------------------------------------------
# Research results come from Tavily: set TAVILY_API_KEY (free key at tavily.com)
# and the OpenCode engine's research step fetches live results and hands them
# to the model inside the prompt. Without a key, research under the OpenCode
# engine runs on model knowledge only. The OpenAI engine uses its own built-in
# web search and does not need this key.
# TAVILY_API_KEY=

# Loopback by default. There is no authentication, so this is what keeps the
# services private to this machine. Do not widen it on a shared network.
FLOW_BIND_HOST=127.0.0.1
FLOW_WEB_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# --- Hosted deployment ------------------------------------------------------
# Set this one variable to run without any backend services. Each visitor's
# workspace and key then live in their own browser.
#
# NEXT_PUBLIC_FLOW_MODE=cloud

# --- Admin dashboard (optional) ---------------------------------------------
# Open /admin/login to see users, visits, runs, and tokens spent. There is no
# link to it anywhere in the app. Both variables must be set, or nobody can
# sign in. Changing the password signs every admin session out.
#
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
#
# Where usage is recorded. Connecting Neon Postgres from the Vercel Marketplace
# (Storage → Create database → Neon) sets this for you; tables create
# themselves. Without it, nothing is recorded and the app works as before.
#
# DATABASE_URL=
